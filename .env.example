# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env com segredos reais (já está no .gitignore).

# Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=gere-uma-chave-segura-aqui

DEBUG=False

# Hosts permitidos (separados por vírgula). No Render isto é resolvido automaticamente
# a partir de RENDER_EXTERNAL_HOSTNAME, então só importa em outros ambientes.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens do frontend autorizadas a chamar a API (CORS). No deploy combinado do Render
# (mesma origem) não é necessário. Útil só se servir o frontend em outro domínio.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Origens confiáveis para CSRF — necessário para o /admin sob HTTPS. No Render é
# resolvido automaticamente; defina manualmente apenas em outros ambientes.
CSRF_TRUSTED_ORIGINS=

# Banco: por padrão usa SQLite (arquivo db.sqlite3 na raiz). Não é preciso configurar nada.
# No Render, o PostgreSQL gerenciado injeta DATABASE_URL automaticamente (requer psycopg2,
# já incluído no requirements.txt).
# DATABASE_URL=

# Superusuário inicial criado pelo comando seed_demo (usado no boot do Render).
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=
